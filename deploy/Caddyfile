# The one public entry to the engine. Caddy issues and renews the certificate
# for CLIMB_DOMAIN, and hands every request to the API, which serves the
# pages beside `/api`. `docs/architecture/README.md` gives why the pages and the
# API share one origin.

{$CLIMB_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8000
}

# CLIMB_REDIRECT_FROM lists further hosts, space-separated, that answer
# with a permanent redirect to CLIMB_DOMAIN. Sign-in returns to the one
# origin alone, so a second host serving the pages would break it.
{$CLIMB_REDIRECT_FROM} {
	redir https://{$CLIMB_DOMAIN}{uri} permanent
}
