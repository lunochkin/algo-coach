# The one public entry to the engine. Caddy issues and renews the certificate
# for ALGO_COACH_DOMAIN, and hands every request to the API, which serves the
# pages beside `/api`. `docs/architecture/README.md` gives why the pages and the
# API share one origin.

{$ALGO_COACH_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8000
}

# ALGO_COACH_REDIRECT_FROM lists further hosts, space-separated, that answer
# with a permanent redirect to ALGO_COACH_DOMAIN. Sign-in returns to the one
# origin alone, so a second host serving the pages would break it.
{$ALGO_COACH_REDIRECT_FROM} {
	redir https://{$ALGO_COACH_DOMAIN}{uri} permanent
}
