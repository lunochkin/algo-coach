    "guess": {
      "default": false,
      "title": "Guess",
      "type": "boolean"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "missed": {
      "items": {
        "type": "integer"
      },
      "title": "Missed",
      "type": "array"
    },
    "question_id": {
      "title": "Question Id",
      "type": "string"
    },
    "traps": {
      "items": {
        "type": "integer"
      },
      "title": "Traps",
      "type": "array"
    },
    "user_id": {
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "wrong": {
      "default": false,
      "title": "Wrong",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "client_id",
    "user_id",
    "device",
    "at",
    "created_at",
    "question_id",
    "correct"
  ],
  "title": "Answer",
  "type": "object"
}
