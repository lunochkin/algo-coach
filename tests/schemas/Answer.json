        "k",
        "p",
        "n"
      ],
      "title": "OpenGrade",
      "type": "string"
    }
  },
  "properties": {
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "client_id": {
      "minLength": 1,
      "title": "Client Id",
      "type": "string"
    },
    "correct": {
      "title": "Correct",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "device": {
      "minLength": 1,
      "title": "Device",
      "type": "string"
    },
    "grade": {
      "anyOf": [
        {
          "$ref": "#/$defs/OpenGrade"
        },
        {
          "type": "null"
        }
      ],
      "default": null
