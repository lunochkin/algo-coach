{
  "$defs": {
    "QuestionFormat": {
      "enum": [
        "choice",
        "short",
        "open"
      ],
      "title": "QuestionFormat",
      "type": "string"
    }
  },
  "properties": {
    "body": {
      "additionalProperties": true,
      "title": "Body",
      "type": "object"
    },
    "code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code"
    },
    "format": {
      "$ref": "#/$defs/QuestionFormat"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "lesson": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lesson"
    },
    "module_id": {
      "title": "Module Id",
      "type": "string"
    },
    "position": {
      "title": "Position",
      "type": "integer"
    },
    "prompt": {
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "rank": {
      "maximum": 3,
      "minimum": 0,
      "title": "Rank",
      "type": "integer"
    },
    "retired_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retired At"
    },
    "slug": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Slug",
      "type": "string"
    },
    "subtopic_id": {
      "title": "Subtopic Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "slug",
    "module_id",
    "subtopic_id",
    "position",
    "rank",
    "kind",
    "format",
    "prompt",
    "body"
  ],
  "title": "Question",
  "type": "object"
}
