#!/bin/sh
# Vocabulary guard: this repo is treated as public from commit 1.
# Blocks staged content containing project-private or off-framing vocabulary.
# Extend the list here; keep it lowercase (match is case-insensitive).

WORDS='REDACTED'

FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^\.githooks/')
[ -z "$FILES" ] && exit 0

HITS=$(echo "$FILES" | xargs grep -lniE "$WORDS" 2>/dev/null)
if [ -n "$HITS" ]; then
    echo "vocab guard: forbidden vocabulary in staged files:" >&2
    echo "$FILES" | xargs grep -niE "$WORDS" 2>/dev/null | head -20 >&2
    echo "(word list: .githooks/pre-commit)" >&2
    exit 1
fi
exit 0
