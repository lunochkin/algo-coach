#!/bin/sh
# Vocabulary guard: this repo is treated as public from commit 1.
# Blocks staged content containing project-private or off-framing vocabulary.
#
# The list itself is untracked, and has to be: it names exactly what must never
# be committed, so committing it is the leak it exists to prevent. Keep it in
# .githooks/words, one extended-regex alternative per line, `#` for comments.
# Anchor a pattern with \b where the bare substring would sit inside ordinary
# English.
#
# Missing list means the guard is not running, which is failed rather than
# passed — a guard that goes quiet when unconfigured is worse than none, since
# nothing says it stopped.

LIST="$(dirname "$0")/words"
if [ ! -f "$LIST" ]; then
    echo "vocab guard: $LIST is missing, so nothing is being checked" >&2
    echo "(one pattern per line; the list is private and never committed)" >&2
    exit 1
fi

WORDS=$(sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$LIST" | grep -v '^$' | paste -sd '|' -)
[ -z "$WORDS" ] && exit 0

FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^\.githooks/')
[ -z "$FILES" ] && exit 0

HITS=$(echo "$FILES" | xargs grep -lniE "$WORDS" 2>/dev/null)
if [ -n "$HITS" ]; then
    echo "vocab guard: forbidden vocabulary in staged files:" >&2
    echo "$FILES" | xargs grep -niE "$WORDS" 2>/dev/null | head -20 >&2
    echo "(word list: .githooks/words)" >&2
    exit 1
fi

# The fitness functions, where the staging touches code: lint and format,
# types, dead code, and the architecture tests (import contracts, module size, import
# paths, package exports). Under five seconds together. The full suite is
# `just test`, run by hand: sixteen seconds per commit is not.
if echo "$FILES" | grep -qE '\.py$|^pyproject\.toml$'; then
    uv run ruff check src tests || exit 1
    uv run ruff format --check src tests || exit 1
    uv run pyright || exit 1
    uv run vulture || exit 1
    uv run pytest -q -n 0 tests/test_architecture.py || exit 1
fi

# The frontend's type check and lint, where the staging touches `web/`. A
# warning fails the lint, as a finding a commit carries past is one nobody reads
# again.
if echo "$FILES" | grep -qE '^web/'; then
    if [ ! -d web/node_modules ]; then
        echo "pre-commit: web/node_modules is missing; run npm --prefix web install" >&2
        exit 1
    fi
    (cd web && npm run --silent typecheck && npm run --silent lint) || exit 1
fi
exit 0
