# Everything the build does not read. `data/` and `content/` are the private
# ones: whoever can pull the image can read what was built into it.
.git
.github
.venv
data
content
dist
web/dist
web/node_modules
tests
docs
**/__pycache__
.env
CLAUDE.local.md
# the workspace's packages and the native app, which the image never reads.
# The app's manifest stays: npm installs a workspace knowing every member
node_modules
native/*
!native/package.json
packages/*/node_modules
