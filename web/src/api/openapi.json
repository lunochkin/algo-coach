          "problem_id",
          "title",
          "difficulty",
          "attempt_count",
          "solved_count",
          "last_attempt_at"
        ],
        "title": "Candidate",
        "description": "A problem offered for a drill. The statement is left out: the clock\nstarts when it is served."
      },
      "Card": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "title": "Slug"
          },
          "technique": {
            "type": "string",
            "title": "Technique"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "title": "Trigger"
          },
          "brief": {
            "type": "string",
            "minLength": 1,
            "title": "Brief"
          },
          "templates": {
            "items": {
              "$ref": "#/components/schemas/Template"
            },
            "type": "array",
            "minItems": 1,
            "title": "Templates"
          },
          "selector": {
            "$ref": "#/components/schemas/Selector"
