            "default": {}
          }
        },
        "type": "object",
        "required": [
          "technique",
          "attempt_count",
          "solved_count"
        ],
        "title": "TechniqueRow",
        "description": "One technique's progress, derived from the log on every read."
      },
      "Template": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "title": "Slug"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "title": "Trigger"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "optional": {
            "type": "boolean",
            "title": "Optional",
            "default": false
          },
          "speedup": {
            "type": "boolean",
            "title": "Speedup",
            "default": true
          },
          "kind": {
            "$ref": "#/components/schemas/TemplateKind",
            "default": "code"
          },
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "trigger",
          "code"
        ],
        "title": "Template",
        "description": "One form reproduced from memory. The unit of recall."
      },
      "TemplateKind": {
        "type": "string",
        "enum": [
          "code",
          "procedure"
        ],
        "title": "TemplateKind"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
