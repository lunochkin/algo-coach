                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Until"
          }
        },
        "type": "object",
        "required": [
          "at"
        ],
        "title": "Pause"
      },
      "ProblemDifficulty": {
        "type": "string",
        "enum": [
          "easy",
          "medium",
          "hard"
        ],
        "title": "ProblemDifficulty"
      },
      "Selector": {
        "properties": {
          "technique": {
            "type": "string",
            "title": "Technique"
          },
          "difficulty": {
            "items": {
              "$ref": "#/components/schemas/ProblemDifficulty"
            },
            "type": "array",
            "title": "Difficulty"
          },
          "size": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Size"
          }
        },
        "type": "object",
        "required": [
          "technique",
          "size"
        ],
        "title": "Selector",
        "description": "What a ladder resolves from. Named fields rather than a filter map, so\na new filter is an additive optional field."
      },
      "Served": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "statement": {
            "type": "string",
            "title": "Statement"
          },
          "signature": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Signature"
          },
          "sitting": {
            "$ref": "#/components/schemas/Sitting"
          }
        },
        "type": "object",
        "required": [
          "title",
          "statement",
          "signature",
          "sitting"
        ],
        "title": "Served",
        "description": "What a solver is handed: the statement and the clock, and nothing the\nproblem was written from."
      },
      "Sitting": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "minLength": 1,
            "title": "User Id"
          },
          "problem_id": {
            "type": "string",
            "minLength": 1,
            "title": "Problem Id"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "pauses": {
            "items": {
              "$ref": "#/components/schemas/Pause"
            },
            "type": "array",
            "title": "Pauses"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "problem_id",
          "started_at"
        ],
        "title": "Sitting"
      },
      "Submission": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "Submission"
      },
      "Submitted": {
        "properties": {
          "attempt": {
            "$ref": "#/components/schemas/Attempt"
          },
          "verification": {
            "$ref": "#/components/schemas/AttemptVerification"
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Failure"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "attempt",
          "verification",
          "failure"
        ],
        "title": "Submitted",
        "description": "The attempt a submission minted, and the per-case verdict behind its\n`solved`."
      },
      "TechniqueRow": {
        "properties": {
          "technique": {
            "type": "string",
            "title": "Technique"
          },
          "attempt_count": {
            "type": "integer",
            "title": "Attempt Count"
          },
          "solved_count": {
            "type": "integer",
            "title": "Solved Count"
          },
          "last_attempt_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
