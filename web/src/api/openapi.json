          },
          "outcome": {
            "$ref": "#/components/schemas/CaseOutcome"
          },
          "elapsed_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Elapsed Ms"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "outcome"
        ],
        "title": "CaseResult"
      },
      "Claim": {
        "properties": {
          "techniques": {
            "items": {
              "type": "string"
