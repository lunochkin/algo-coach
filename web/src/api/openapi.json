            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Call Id"
          },
          "pin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pin"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperature"
          },
          "cost": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "attempt_id": {
            "type": "string",
            "title": "Attempt Id"
          },
          "techniques": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Techniques"
          },
          "declined": {
            "type": "boolean",
            "title": "Declined",
            "default": false
          },
          "source": {
            "$ref": "#/components/schemas/ClaimSource"
          },
          "informed_by": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Informed By"
          },
          "confidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Confidence"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "created_at",
          "attempt_id",
          "source"
        ],
        "title": "AttemptClaim",
        "description": "Which techniques an attempt used, as one writer claimed them."
      },
      "AttemptVerification": {
        "properties": {
          "cap_ms": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Cap Ms"
          },
          "runner": {
            "type": "string",
            "minLength": 1,
            "title": "Runner"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/CaseResult"
            },
            "type": "array",
            "title": "Results"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "attempt_id": {
            "type": "string",
            "title": "Attempt Id"
          }
        },
        "type": "object",
        "required": [
          "cap_ms",
          "runner",
          "id",
          "created_at",
          "attempt_id"
        ],
        "title": "AttemptVerification",
        "description": "Private to the user, where a solution's run is product data: `log.md`."
