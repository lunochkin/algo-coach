        "required": [
          "id",
          "slug",
          "technique",
          "title",
          "trigger",
          "brief",
          "templates",
          "selector"
        ],
        "title": "Card",
        "description": "Teaching content for one technique: forms to reproduce, and a\nselector."
      },
      "CaseOutcome": {
        "type": "string",
        "enum": [
          "passed",
          "wrong",
          "timeout",
          "crashed"
