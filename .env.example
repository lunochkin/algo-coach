# API key for the attribution classifier (Phase 3)
ANTHROPIC_API_KEY=

# The broker's base URL. Unset, a submission runs in the local subprocess,
# which is what a sitting on this machine uses: gVisor runs only on Linux
ALGO_COACH_BROKER=

# The deployed database, through `just tunnel` in the deployment repo: `just prod`
PROD_DATABASE_URL=postgresql+psycopg://algo_coach:@127.0.0.1:5433/algo_coach
